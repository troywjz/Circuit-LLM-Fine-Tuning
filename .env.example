# Teacher 接口配置模板。复制为本机 .env 后再填写；此文件不是 Python 虚拟环境（venv）。
# 仅填写由服务商提供的接口参数，不要把真实密钥提交到仓库。
#
# 关键字段：
# 1. TEACHER_PROVIDER：接口协议，openai 或 anthropic。
# 2. TEACHER_BASE_URL：服务商给出的 API 根地址或兼容网关地址。
# 3. TEACHER_API_KEY：在本机 .env 中填写；不要写入模板或公开文档。
# 4. TEACHER_MODEL_ID：服务商实际支持的模型 ID。
#
# OpenAI 协议可将 gpt-6.1-sol 配置为 responses；claude-opus-5-5 使用
# anthropic 协议。第三方兼容平台请按其实际协议和文档填写，不要仅凭模型名称推断。
TEACHER_PROVIDER=openai
TEACHER_OPENAI_API=responses
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL_ID=
TEACHER_MAX_OUTPUT_TOKENS=8192
TEACHER_TIMEOUT_SECONDS=120
TEACHER_MAX_RETRIES=2
TEACHER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36
TEACHER_PROXY_URL=
TEACHER_OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
TEACHER_EXTRA_BODY_JSON={}

# 备用教师接口。先按实际网关协议配置；本项目连接测试会先试 Anthropic，
# 若接口明确不支持该协议，再按 TEACHER_BACKUP_OPENAI_API 试 OpenAI 兼容协议。
TEACHER_BACKUP_PROVIDER=anthropic
TEACHER_BACKUP_OPENAI_API=responses
TEACHER_BACKUP_BASE_URL=
TEACHER_BACKUP_API_KEY=
TEACHER_BACKUP_MODEL_ID=
TEACHER_BACKUP_MAX_OUTPUT_TOKENS=8192
TEACHER_BACKUP_TIMEOUT_SECONDS=120
TEACHER_BACKUP_MAX_RETRIES=0
TEACHER_BACKUP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36
TEACHER_BACKUP_PROXY_URL=
TEACHER_BACKUP_OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
TEACHER_BACKUP_EXTRA_BODY_JSON={}

# 连通测试与数据准备依次使用备用、原主、第三接口；参考评测固定使用原主接口。
# 顺序里的名字对应三套配置：backup（备用）、primary（原主）、tertiary（第三）。
TEACHER_PROFILE_ORDER_CONNECTIVITY=backup,primary,tertiary
TEACHER_PROFILE_ORDER_DATA=backup,primary,tertiary
TEACHER_PROFILE_ORDER_REFERENCE=primary

# 备用接口使用 Anthropic，第三接口使用 OpenAI Chat Completions。

# 第三顺位教师接口（OpenAI 协议，接 OpenAI 或其兼容中转站）。
# 只有在前两项都明确不可用时才会用到；provider 固定为 openai。
# OPENAI_API 两种取值：chat_completions（兼容面更广）或 responses（OpenAI 官方新接口）。
TEACHER_TERTIARY_PROVIDER=openai
TEACHER_TERTIARY_OPENAI_API=chat_completions
TEACHER_TERTIARY_BASE_URL=
TEACHER_TERTIARY_API_KEY=
TEACHER_TERTIARY_MODEL_ID=
TEACHER_TERTIARY_MAX_OUTPUT_TOKENS=8192
TEACHER_TERTIARY_TIMEOUT_SECONDS=180
TEACHER_TERTIARY_MAX_RETRIES=0
TEACHER_TERTIARY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36
TEACHER_TERTIARY_PROXY_URL=
TEACHER_TERTIARY_OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
TEACHER_TERTIARY_EXTRA_BODY_JSON={}
